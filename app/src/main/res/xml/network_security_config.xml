<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- VPN Gate's server-list API (and its rotating mirror hosts, which
         live on arbitrary hosts/ports) is HTTP-only. Android blocks
         cleartext by default for apps targeting API 28+. The app's only
         network use is fetching that public list; actual VPN traffic is
         handled by the OpenVPN engine app, not by this config. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
